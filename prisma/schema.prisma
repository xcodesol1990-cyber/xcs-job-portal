generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [citext]
}

enum UserRole {
  CLIENT
  FREELANCER
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  BANNED
  DELETED

  @@map("user_status")
}

enum VerificationPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  EMAIL_CHANGE

  @@map("VerificationPurpose")
}

enum JobStatus {
  DRAFT
  PENDING_REVIEW
  OPEN
  IN_PROGRESS
  COMPLETED
  CLOSED
  CANCELLED
  REJECTED

  @@map("job_status")
}

enum BudgetType {
  FIXED
  HOURLY

  @@map("budget_type")
}

enum ProposalStatus {
  SUBMITTED
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN

  @@map("proposal_status")
}

enum ContractStatus {
  PENDING_FUNDING
  ACTIVE
  COMPLETED
  CANCELLED
  DISPUTED

  @@map("contract_status")
}

enum MilestoneStatus {
  PENDING
  FUNDED
  SUBMITTED
  REVISION_REQUESTED
  APPROVED
  RELEASED
  REFUNDED
  DISPUTED

  @@map("milestone_status")
}

enum LedgerType {
  ESCROW_FUND
  ESCROW_RELEASE
  PLATFORM_FEE
  PAYOUT
  REFUND
  DISPUTE_ADJUSTMENT

  @@map("ledger_type")
}

enum PaymentStatus {
  REQUIRES_ACTION
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED

  @@map("PaymentStatus")
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED

  @@map("ScanStatus")
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_CLIENT
  RESOLVED_FREELANCER
  RESOLVED_SPLIT

  @@map("DisputeStatus")
}

model User {
  id                      String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                   String     @unique @db.Citext
  emailVerifiedAt         DateTime?  @map("email_verified_at") @db.Timestamptz
  passwordHash            String?    @map("password_hash")
  name                    String
  imageUrl                String?    @map("image_url")
  roles                   UserRole[] @default([])
  status                  UserStatus @default(PENDING_VERIFICATION)
  totpSecretEnc           String?    @map("totp_secret_enc")
  totpEnabled             Boolean    @default(false) @map("totp_enabled")
  failedLoginCount        Int        @default(0) @map("failed_login_count")
  lockedUntil             DateTime?  @map("locked_until") @db.Timestamptz
  lastLoginAt             DateTime?  @map("last_login_at") @db.Timestamptz
  stripeCustomerId        String?    @unique @map("stripe_customer_id")
  stripeConnectAccountId  String?    @unique @map("stripe_connect_account_id")
  stripePayoutsEnabled    Boolean    @default(false) @map("stripe_payouts_enabled")
  country                 String?    @db.Char(2)
  timezone                String?
  deletedAt               DateTime?  @map("deleted_at") @db.Timestamptz
  createdAt               DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  accounts             Account[]
  sessions             Session[]
  verificationTokens   VerificationToken[]
  freelancerProfile    FreelancerProfile?
  clientProfile        ClientProfile?
  jobs                 Job[]                 @relation("JobClient")
  savedJobs            SavedJob[]
  proposals            Proposal[]            @relation("ProposalFreelancer")
  clientContracts      Contract[]            @relation("ContractClient")
  freelancerContracts  Contract[]            @relation("ContractFreelancer")
  payments             Payment[]
  ledgerEntries        LedgerEntry[]
  payouts              Payout[]
  attachments          Attachment[]
  clientConversations  Conversation[]        @relation("ConversationClient")
  freelancerConversations Conversation[]     @relation("ConversationFreelancer")
  messages             Message[]
  reviewsAuthored      Review[]              @relation("ReviewReviewer")
  reviewsReceived      Review[]              @relation("ReviewReviewee")
  disputesOpened       Dispute[]             @relation("DisputeOpenedBy")
  disputesResolved     Dispute[]             @relation("DisputeResolvedBy")
  reports              Report[]
  notifications        Notification[]
  idempotencyKeys      IdempotencyKey[]
  auditLogs            AuditLog[]

  @@map("users")
}

model Account {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String  @default("oauth")
  provider          String
  providerAccountId String  @map("provider_account_id")
  refreshToken      String? @map("refresh_token")
  accessToken       String? @map("access_token")
  expiresAt         Int?    @map("expires_at")
  tokenType         String? @map("token_type")
  scope             String?
  idToken           String? @map("id_token")
  sessionState      String? @map("session_state")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  sessionTokenHash String    @unique @map("session_token_hash")
  ip               String?   @db.Inet
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  purpose   VerificationPurpose
  tokenHash String               @unique @map("token_hash")
  expiresAt DateTime             @map("expires_at") @db.Timestamptz
  usedAt    DateTime?            @map("used_at") @db.Timestamptz
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_tokens")
}

model FreelancerProfile {
  userId            String   @id @map("user_id") @db.Uuid
  headline          String?
  bio               String?
  hourlyRateCents   Int?     @map("hourly_rate_cents")
  currency          String   @default("USD") @db.Char(3)
  availability      String?
  experienceLevel   String?  @map("experience_level")
  jobSuccessScore   Decimal? @map("job_success_score") @db.Decimal(5, 2)
  totalEarnedCents  BigInt   @default(0) @map("total_earned_cents")
  tags              String[] @default([])
  githubUrl         String?  @map("github_url")
  linkedinUrl       String?  @map("linkedin_url")
  websiteUrl        String?  @map("website_url")
  yearsOfExperience Int?     @map("years_of_experience")
  englishProficiency String? @map("english_proficiency")
  searchVector      Unsupported("tsvector")? @map("search_vector")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills          FreelancerSkill[]
  portfolioItems  PortfolioItem[]

  @@map("freelancer_profiles")
}

model ClientProfile {
  userId           String   @id @map("user_id") @db.Uuid
  companyName      String?  @map("company_name")
  website          String?
  companySize      String?  @map("company_size")
  industry         String?  @map("industry")
  about            String?  @map("about")
  linkedinUrl      String?  @map("linkedin_url")
  paymentVerified  Boolean  @default(false) @map("payment_verified")
  totalSpentCents  BigInt   @default(0) @map("total_spent_cents")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  parentId  Int?     @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryParent")
  jobs     Job[]

  @@index([parentId])
  @@map("categories")
}

model Skill {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.Citext
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  freelancerSkills FreelancerSkill[]
  jobSkills        JobSkill[]

  @@map("skills")
}

model FreelancerSkill {
  freelancerId String @map("freelancer_id") @db.Uuid
  skillId      Int    @map("skill_id")

  freelancer FreelancerProfile @relation(fields: [freelancerId], references: [userId], onDelete: Cascade)
  skill      Skill             @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([freelancerId, skillId])
  @@index([skillId])
  @@map("freelancer_skills")
}

model PortfolioItem {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  freelancerId String   @map("freelancer_id") @db.Uuid
  title        String
  description  String?
  url          String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  freelancer FreelancerProfile @relation(fields: [freelancerId], references: [userId], onDelete: Cascade)

  @@index([freelancerId])
  @@map("portfolio_items")
}

model Job {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientId        String    @map("client_id") @db.Uuid
  categoryId      Int?      @map("category_id")
  title           String
  description     String
  budgetType      BudgetType @map("budget_type")
  budgetMinCents  Int?      @map("budget_min_cents")
  budgetMaxCents  Int?      @map("budget_max_cents")
  currency        String    @default("USD") @db.Char(3)
  experienceLevel String?   @map("experience_level")
  duration        String?
  scope           String?   @map("scope")
  timeCommitment  String?   @map("time_commitment")
  deliverables    String?   @map("deliverables")
  screeningQuestions String[] @default([]) @map("screening_questions")
  status          JobStatus @default(DRAFT)
  proposalsCount  Int       @default(0) @map("proposals_count")
  dedupeHash      String    @map("dedupe_hash")
  searchVector    Unsupported("tsvector")? @map("search_vector")
  version         Int       @default(0)
  publishedAt     DateTime? @map("published_at") @db.Timestamptz
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  client        User           @relation("JobClient", fields: [clientId], references: [id], onDelete: Restrict)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  skills        JobSkill[]
  savedBy       SavedJob[]
  proposals     Proposal[]
  contracts     Contract[]
  attachments   Attachment[]
  conversations Conversation[]

  @@index([status, publishedAt(sort: Desc)], map: "idx_jobs_status_published")
  @@index([clientId], map: "idx_jobs_client")
  @@index([categoryId])
  @@index([dedupeHash])
  @@map("jobs")
}

model JobSkill {
  jobId   String @map("job_id") @db.Uuid
  skillId Int    @map("skill_id")

  job   Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([jobId, skillId])
  @@index([skillId])
  @@map("job_skills")
}

model SavedJob {
  userId String @map("user_id") @db.Uuid
  jobId  String @map("job_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([userId, jobId])
  @@index([jobId])
  @@map("saved_jobs")
}

model Proposal {
  id            String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId         String          @map("job_id") @db.Uuid
  freelancerId  String          @map("freelancer_id") @db.Uuid
  coverLetter   String          @map("cover_letter")
  bidCents      Int             @map("bid_cents")
  currency      String          @default("USD") @db.Char(3)
  estimatedDays Int?            @map("estimated_days")
  status        ProposalStatus  @default(SUBMITTED)
  version       Int             @default(0)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  freelancer  User         @relation("ProposalFreelancer", fields: [freelancerId], references: [id], onDelete: Restrict)
  contract    Contract?
  attachments Attachment[]

  @@unique([jobId, freelancerId])
  @@index([freelancerId, status], map: "idx_proposals_freelancer")
  @@map("proposals")
}

model Contract {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId           String          @map("job_id") @db.Uuid
  proposalId      String          @unique @map("proposal_id") @db.Uuid
  clientId        String          @map("client_id") @db.Uuid
  freelancerId    String          @map("freelancer_id") @db.Uuid
  totalCents      BigInt          @map("total_cents")
  currency        String          @db.Char(3)
  platformFeeBps  Int             @map("platform_fee_bps")
  status          ContractStatus  @default(PENDING_FUNDING)
  version         Int             @default(0)
  startedAt       DateTime?       @map("started_at") @db.Timestamptz
  completedAt     DateTime?       @map("completed_at") @db.Timestamptz
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  job           Job            @relation(fields: [jobId], references: [id], onDelete: Restrict)
  proposal      Proposal       @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  client        User           @relation("ContractClient", fields: [clientId], references: [id], onDelete: Restrict)
  freelancer    User           @relation("ContractFreelancer", fields: [freelancerId], references: [id], onDelete: Restrict)
  milestones    Milestone[]
  ledgerEntries LedgerEntry[]
  conversations Conversation[]
  reviews       Review[]
  disputes      Dispute[]

  @@index([jobId])
  @@index([clientId])
  @@index([freelancerId])
  @@map("contracts")
}

model Milestone {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractId   String          @map("contract_id") @db.Uuid
  position     Int
  title        String
  description  String?
  amountCents  BigInt          @map("amount_cents")
  status       MilestoneStatus @default(PENDING)
  dueDate      DateTime?       @map("due_date") @db.Date
  submittedAt  DateTime?       @map("submitted_at") @db.Timestamptz
  approvedAt   DateTime?       @map("approved_at") @db.Timestamptz
  releasedAt   DateTime?       @map("released_at") @db.Timestamptz
  version      Int             @default(0)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  contract      Contract       @relation(fields: [contractId], references: [id], onDelete: Restrict)
  payments      Payment[]
  ledgerEntries LedgerEntry[]
  attachments   Attachment[]
  disputes      Dispute[]

  @@unique([contractId, position])
  @@index([contractId])
  @@map("milestones")
}

model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  milestoneId       String        @map("milestone_id") @db.Uuid
  payerId           String        @map("payer_id") @db.Uuid
  amountCents       BigInt        @map("amount_cents")
  currency          String        @db.Char(3)
  provider          String        @default("stripe")
  providerPaymentId String        @unique @map("provider_payment_id")
  status            PaymentStatus
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  payer     User      @relation(fields: [payerId], references: [id], onDelete: Restrict)

  @@index([milestoneId])
  @@index([payerId])
  @@map("payments")
}

model LedgerEntry {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type           LedgerType
  contractId     String?    @map("contract_id") @db.Uuid
  milestoneId    String?    @map("milestone_id") @db.Uuid
  userId         String?    @map("user_id") @db.Uuid
  amountCents    BigInt     @map("amount_cents")
  currency       String     @db.Char(3)
  providerRef    String?    @map("provider_ref")
  idempotencyKey String     @unique @map("idempotency_key")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz

  contract  Contract?  @relation(fields: [contractId], references: [id], onDelete: Restrict)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  user      User?      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([contractId])
  @@index([milestoneId])
  @@index([userId])
  @@map("ledger_entries")
}

model Payout {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  freelancerId     String   @map("freelancer_id") @db.Uuid
  amountCents      BigInt   @map("amount_cents")
  currency         String   @db.Char(3)
  providerPayoutId String?  @unique @map("provider_payout_id")
  status           String
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  freelancer User @relation(fields: [freelancerId], references: [id], onDelete: Restrict)

  @@index([freelancerId])
  @@map("payouts")
}

model Attachment {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String     @map("owner_id") @db.Uuid
  storageKey  String     @unique @map("storage_key")
  filename    String
  mimeType    String     @map("mime_type")
  sizeBytes   BigInt     @map("size_bytes")
  sha256      String
  scanStatus  ScanStatus @default(PENDING) @map("scan_status")
  jobId       String?    @map("job_id") @db.Uuid
  proposalId  String?    @map("proposal_id") @db.Uuid
  milestoneId String?    @map("milestone_id") @db.Uuid
  messageId   String?    @map("message_id") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  job       Job?      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  proposal  Proposal? @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  message   Message?  @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([jobId])
  @@index([proposalId])
  @@index([milestoneId])
  @@index([messageId])
  @@map("attachments")
}

model Conversation {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  jobId         String?   @map("job_id") @db.Uuid
  contractId    String?   @map("contract_id") @db.Uuid
  clientId      String    @map("client_id") @db.Uuid
  freelancerId  String    @map("freelancer_id") @db.Uuid
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  job        Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: Restrict)
  client     User     @relation("ConversationClient", fields: [clientId], references: [id], onDelete: Restrict)
  freelancer User     @relation("ConversationFreelancer", fields: [freelancerId], references: [id], onDelete: Restrict)
  messages   Message[]

  @@unique([jobId, clientId, freelancerId])
  @@index([contractId])
  @@index([clientId])
  @@index([freelancerId])
  @@map("conversations")
}

model Message {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  senderId       String    @map("sender_id") @db.Uuid
  body           String
  clientMsgId    String    @map("client_msg_id") @db.Uuid
  readAt         DateTime? @map("read_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Restrict)
  attachments  Attachment[]

  @@unique([conversationId, senderId, clientMsgId])
  @@index([conversationId, createdAt(sort: Desc)], map: "idx_messages_conv_created")
  @@index([senderId])
  @@map("messages")
}

model Review {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractId String   @map("contract_id") @db.Uuid
  reviewerId String   @map("reviewer_id") @db.Uuid
  revieweeId String   @map("reviewee_id") @db.Uuid
  rating     Int      @db.SmallInt
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  reviewer User     @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewee User     @relation("ReviewReviewee", fields: [revieweeId], references: [id], onDelete: Restrict)

  @@unique([contractId, reviewerId])
  @@index([revieweeId])
  @@map("reviews")
}

model Dispute {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractId     String        @map("contract_id") @db.Uuid
  milestoneId    String?       @map("milestone_id") @db.Uuid
  openedById     String        @map("opened_by") @db.Uuid
  reason         String
  status         DisputeStatus @default(OPEN)
  resolutionNote String?       @map("resolution_note")
  resolvedById   String?       @map("resolved_by") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  contract   Contract   @relation(fields: [contractId], references: [id], onDelete: Restrict)
  milestone  Milestone? @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  openedBy   User       @relation("DisputeOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  resolvedBy User?      @relation("DisputeResolvedBy", fields: [resolvedById], references: [id], onDelete: Restrict)

  @@index([contractId])
  @@index([milestoneId])
  @@index([openedById])
  @@map("disputes")
}

model Report {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId String   @map("reporter_id") @db.Uuid
  targetType String   @map("target_type")
  targetId   String   @map("target_id") @db.Uuid
  reason     String
  status     String   @default("OPEN")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Restrict)

  @@unique([reporterId, targetType, targetId])
  @@index([status])
  @@map("reports")
}

model Notification {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String
  payload   Json
  readAt    DateTime? @map("read_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model IdempotencyKey {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  key            String
  endpoint       String
  requestHash    String    @map("request_hash")
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  lockedAt       DateTime? @map("locked_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model WebhookEvent {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    String
  eventId     String    @map("event_id")
  type        String
  payload     Json
  processedAt DateTime? @map("processed_at") @db.Timestamptz
  error       String?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([provider, eventId])
  @@index([processedAt])
  @@map("webhook_events")
}

model Outbox {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topic     String
  entityId  String?   @map("entity_id") @db.Uuid
  payload   Json
  runAfter  DateTime  @default(now()) @map("run_after") @db.Timestamptz
  attempts  Int       @default(0)
  doneAt    DateTime? @map("done_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([topic, entityId], map: "uq_outbox_topic_entity")
  @@index([runAfter, doneAt])
  @@map("outbox")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  ip         String?  @db.Inet
  userAgent  String?  @map("user_agent")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model PlatformSetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("platform_settings")
}
