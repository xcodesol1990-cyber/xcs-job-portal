# App
NODE_ENV=development
APP_URL=http://localhost:3000
# 32+ character secret used for Auth.js and HMAC
AUTH_SECRET=replace-with-32-plus-character-secret
# 32-byte key as 64 hex chars (AES-256-GCM)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CRON_SECRET=replace-with-cron-bearer-secret

# PostgreSQL — pooled for runtime, direct for migrations
DATABASE_URL=postgresql://user:password@localhost:5432/worknest?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://user:password@localhost:5432/worknest

# Optional monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Optional providers (wired in later phases)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=WorkNest <noreply@localhost>
BLOB_READ_WRITE_TOKEN=
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
