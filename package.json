{
  "name": "worknest",
  "version": "0.1.0",
  "private": true,
  "description": "WorkNest freelance marketplace",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && prisma migrate deploy && tsx prisma/seed.ts && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "prisma:validate": "prisma validate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.17.1",
    "@vercel/blob": "^2.8.2",
    "argon2": "^0.44.0",
    "lucide-react": "^1.65.0",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "pino": "^10.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "stripe": "^23.1.0",
    "tsx": "^4.23.15",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "prettier": "^3.6.2",
    "prisma": "^6.17.1",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^3.2.4"
  }
}
